{
    "name": "hollis-labs/ui-builder",
    "description": "Database-driven UI configuration system for building dynamic interfaces without code changes",
    "type": "library",
    "keywords": ["laravel", "ui", "builder", "dynamic", "configuration"],
    "license": "proprietary",
    "authors": [
        {
            "name": "Hollis Labs",
            "email": "info@hollislabs.com"
        }
    ],
    "require": {
        "php": "^8.1|^8.2|^8.3",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "illuminate/database": "^10.0|^11.0|^12.0",
        "illuminate/contracts": "^10.0|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Modules\\UiBuilder\\": "src/",
            "Modules\\UiBuilder\\Database\\Seeders\\": "database/seeders/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Modules\\UiBuilder\\UiBuilderServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
