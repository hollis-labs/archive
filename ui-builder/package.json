{
  "name": "@hollis-labs/ui-builder",
  "version": "1.0.2",
  "type": "module",
  "main": "./dist/ui-builder.cjs",
  "module": "./dist/ui-builder.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/ui-builder.js",
      "require": "./dist/ui-builder.cjs"
    }
  },
  "files": [
    "dist",
    "resources",
    "src",
    "config",
    "routes",
    "database",
    "composer.json"
  ],
  "scripts": {
    "build": "vite build -c vite.lib.config.ts",
    "dev": "vite build -c vite.lib.config.ts --watch"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  },
  "devDependencies": {
    "@types/react": "^19.2.2",
    "@vitejs/plugin-react": "^4",
    "typescript": "^5",
    "vite": "^6",
    "vite-plugin-dts": "^4"
  }
}
